{
  "name": "stackdeck",
  "version": "0.10.1",
  "description": "Run two branches of the same repo side by side, each on its own port. A browser and terminal board for your local dev services — git-worktree aware, zero dependencies, never leaves 127.0.0.1.",
  "license": "MIT",
  "author": "beingmechon",
  "homepage": "https://beingmechon.github.io/stackdeck",
  "bugs": "https://github.com/beingmechon/stackdeck/issues",
  "bin": {
    "stackdeck": "bin/stackdeck.js"
  },
  "main": "server.js",
  "files": [
    "server.js",
    "index.html",
    "bin/",
    "scripts/macos-app.sh",
    "scripts/Stackdeck.icns"
  ],
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18.13"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "keywords": [
    "process-manager",
    "dev-server",
    "dashboard",
    "local-development",
    "git",
    "procfile",
    "hotel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beingmechon/stackdeck.git"
  }
}
